# ---------------------------------------------------------------------------
# Critique — environment variables
# Copy this file to `.env` and fill in your real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- LLM (AgentRouter, OpenAI-compatible) ----------------------------------
# Get these from your AgentRouter dashboard. Because AgentRouter speaks the
# OpenAI API format, you can point these at Groq / OpenRouter / Gemini's
# OpenAI-compatible endpoint instead, with no code changes.
LLM_BASE_URL=https://agentrouter.org/v1
LLM_API_KEY=your_agentrouter_api_key_here
LLM_MODEL=claude-opus-5

# --- Last.fm (free, API key only) ------------------------------------------
# Create one instantly at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# --- Spotify (OAuth 2.0) ---------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard
# Add the redirect URI below to the app's settings.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8501

# --- MyAnimeList (OPTIONAL) ------------------------------------------------
# Leave blank to use the free Jikan API (stats + favorites, no key needed).
# Provide a Client ID from https://myanimelist.net/apiconfig to unlock the
# full anime list with genres.
MAL_CLIENT_ID=

# --- GitHub (OPTIONAL) -----------------------------------------------------
# Leave blank to use the public GitHub REST API without authentication.
# Provide a Personal Access Token (classic or fine-grained) to increase rate limits.
GITHUB_TOKEN=

