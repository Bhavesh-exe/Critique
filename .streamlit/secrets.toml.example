# ---------------------------------------------------------------------------
# Critique — Streamlit Cloud secrets template.
# Copy to `.streamlit/secrets.toml` locally, OR paste these into the
# "Secrets" box in the Streamlit Community Cloud dashboard when deploying.
# `secrets.toml` is gitignored. Values must be quoted TOML strings.
# ---------------------------------------------------------------------------

LLM_BASE_URL = "https://agentrouter.org/v1"
LLM_API_KEY = "your_agentrouter_api_key_here"
LLM_MODEL = "gpt-4o-mini"

LASTFM_API_KEY = "your_lastfm_api_key_here"

SPOTIFY_CLIENT_ID = "your_spotify_client_id_here"
SPOTIFY_CLIENT_SECRET = "your_spotify_client_secret_here"
SPOTIFY_REDIRECT_URI = "http://localhost:8501"

MAL_CLIENT_ID = ""
